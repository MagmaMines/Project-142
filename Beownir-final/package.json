{
  "name": "beownir",
  "version": "3.0.0-rc.6",
  "private": true,
  "description": "Single-file browser IDE with a Node-compatible Web Worker runtime and concurrent npm registry installer",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node tools/check.mjs",
    "sync": "node tools/sync-embedded.mjs",
    "verify": "node tools/sync-embedded.mjs --check && node tools/gen-rollup-compat.mjs --check && node tools/gen-compat-shims.mjs --check && node tools/gen-node-path.mjs --check && node tools/gen-node-querystring.mjs --check && node tools/gen-wasi.mjs --check && node tools/gen-brotli.mjs --check && node tools/deploy-files.mjs && node tools/check.mjs && node tools/build-standalone.mjs --check && node tools/compat-report.mjs --fail-under 0.985 && node --test \"test/*.test.mjs\"",
    "serve:static": "node tools/serve-static.mjs",
    "compat": "node tools/compat-report.mjs",
    "compat:write": "node tools/compat-report.mjs --write",
    "differential": "node tools/node-differential.mjs",
    "matrix": "node tools/framework-matrix.mjs",
    "matrix:write": "node tools/framework-matrix.mjs --write",
    "matrix:check": "node tools/framework-matrix.mjs --check",
    "build": "node tools/framework-matrix.mjs",
    "build:check": "node tools/framework-matrix.mjs --check",
    "build:standalone": "node tools/build-standalone.mjs",
    "standalone:check": "node tools/build-standalone.mjs --check",
    "standalone:smoke": "node tools/standalone-smoke.mjs beownir-standalone.html",
    "embed:build": "node tools/build-embed.mjs",
    "embed:check": "node tools/build-embed.mjs --check",
    "embed:e2e": "node test/embed/embed-e2e.cjs",
    "e2e:browser": "node test/browser/vite-hmr-e2e.cjs",
    "e2e:threads": "node test/browser/worker-threads-e2e.cjs",
    "release:candidate": "node tools/package-release.mjs",
    "reports": "node tools/reports.mjs",
    "reports:fast": "node tools/reports.mjs --fast",
    "deploy:headers": "node tools/deploy-files.mjs"
  },
  "files": [
    "o"
  ],
  "exports": {
    ".": {
      "types": "./o/embed/beownir-kernel.d.ts",
      "default": "./o/embed/kernel.mjs"
    },
    "./kernel": {
      "types": "./o/embed/beownir-kernel.d.ts",
      "default": "./o/embed/beownir-kernel.js"
    },
    "./vite": {
      "types": "./o/embed/vite.d.ts",
      "default": "./o/embed/vite.mjs"
    },
    "./next": {
      "types": "./o/embed/next.d.ts",
      "default": "./o/embed/next.mjs"
    },
    "./server": {
      "types": "./o/embed/server.d.ts",
      "default": "./o/embed/server.mjs"
    },
    "./package.json": "./package.json"
  }
}
